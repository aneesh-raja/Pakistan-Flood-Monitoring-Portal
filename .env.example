# =====================================================
# PAKISTAN FLOOD MONITORING PORTAL — ENV VARIABLES
# =====================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# ─── Google Earth Engine ──────────────────────────
# Sign up at https://earthengine.google.com/
# Create a Service Account at https://console.cloud.google.com/
# Download the JSON key and provide its path below
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./gee_credentials.json

# ─── Supabase ─────────────────────────────────────
# Create a project at https://supabase.com/
# Enable PostGIS extension in Database > Extensions
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── OpenWeatherMap ───────────────────────────────
# Register at https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweathermap-api-key

# ─── Mapbox ───────────────────────────────────────
# Register at https://mapbox.com/
# Copy your Default Public Token from Account > Tokens
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# ─── FastAPI Settings ─────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_RELOAD=true

# ─── CORS ─────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Open-Meteo Flood API ─────────────────────────
# No API key required — uses public endpoint
# https://flood-api.open-meteo.com/v1/flood
OPEN_METEO_FLOOD_BASE_URL=https://flood-api.open-meteo.com/v1/flood
